diff --git a/libs/vkd3d/squark_census.c b/libs/vkd3d/squark_census.c
new file mode 100644
index 00000000..b9b83614
--- /dev/null
+++ b/libs/vkd3d/squark_census.c
@@ -0,0 +1,286 @@
+/*
+ * Squark: an API census of what an application asks D3D12 for (off unless VKD3D_SQUARK_CENSUS=1).
+ *
+ * Counts calls (draws, dispatches, barriers, queries, copies, submissions, presents, resource, view and
+ * object creation), the formats resources and views are created with, the queues, descriptor heaps,
+ * query heaps and command signatures an application creates, and its swapchain settings, then writes
+ * them to a text file. Written to answer "which D3D12 features does Microsoft Flight Simulator 2024
+ * really use" without a debugger or a capture tool: the counters are atomics, nothing is logged per
+ * call, and when the variable is not set every hook is one load of a global and a branch.
+ *
+ *   VKD3D_SQUARK_CENSUS=1              turn it on
+ *   VKD3D_SQUARK_CENSUS_FILE=<path>    where to write (default vkd3d-squark-census.txt in the current
+ *                                      directory); rewritten at the end of the window, when the device is
+ *                                      destroyed and at a normal process exit
+ *   VKD3D_SQUARK_CENSUS_EVERY=N        every N presents (default 3600) also write <path>.<presents>, so two
+ *                                      snapshots taken in a steady scene give its per-frame numbers
+ *   VKD3D_SQUARK_CENSUS_WINDOW=A-B     also count presents A..B-1 separately, so per-frame numbers of a
+ *                                      steady scene are not mixed with loading
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#include "vkd3d_private.h"
+
+#include <stdio.h>
+
+uint32_t vkd3d_squark_census_on;
+
+static const char * const squark_census_names[SQC_COUNT] =
+{
+#define SQC_NAME(x) #x,
+    SQC_LIST(SQC_NAME)
+#undef SQC_NAME
+};
+
+enum { SQC_RECORDS = 512, SQC_FORMATS = 256, SQC_FEATURES = 128 };
+
+struct squark_census_record
+{
+    uint32_t a, b, c, d, e, f, g, h;
+};
+
+static struct
+{
+    uint64_t total[SQC_COUNT];
+    uint64_t window[SQC_COUNT];
+    uint64_t formats[SQC_FMT_KIND_COUNT][SQC_FORMATS];
+    uint64_t srv_dims[16], uav_dims[16], rtv_dims[16], dsv_dims[16];
+    uint64_t resource_dims[8], heap_types[8];
+    uint64_t end_query_types[16], sync_intervals[8], features[SQC_FEATURES];
+    uint32_t record_count[SQC_REC_KIND_COUNT];
+    struct squark_census_record records[SQC_REC_KIND_COUNT][SQC_RECORDS];
+    uint32_t window_start, window_end, window_active, window_written, every;
+    uint64_t presents;
+    char path[512];
+} census;
+
+static const char * const squark_census_fmt_kinds[SQC_FMT_KIND_COUNT] =
+{
+    "resource_texture", "resource_render_target", "resource_depth_stencil", "resource_uav_texture",
+    "resource_simultaneous_access", "view_rtv", "view_dsv", "view_srv", "view_uav",
+};
+
+static const char * const squark_census_rec_kinds[SQC_REC_KIND_COUNT] =
+{
+    "queue (type priority flags node_mask)",
+    "descriptor_heap (type num_descriptors flags)",
+    "query_heap (type count)",
+    "command_signature (byte_stride num_arguments argument_type_mask)",
+    "swapchain (width height format buffer_count swap_effect flags scaling alpha_mode)",
+    "frame_latency (max_latency)",
+    "heap (type size_kib flags alignment)",
+};
+
+void vkd3d_squark_census_init(void)
+{
+    static uint32_t done;
+    char env[64];
+    unsigned int a, b;
+
+    if (vkd3d_atomic_uint32_exchange_explicit(&done, 1, vkd3d_memory_order_relaxed))
+        return;
+    if (!vkd3d_get_env_var("VKD3D_SQUARK_CENSUS", env, sizeof(env)) || env[0] != '1')
+        return;
+    if (!vkd3d_get_env_var("VKD3D_SQUARK_CENSUS_FILE", census.path, sizeof(census.path)) || !census.path[0])
+        strcpy(census.path, "vkd3d-squark-census.txt");
+    census.every = 3600;
+    if (vkd3d_get_env_var("VKD3D_SQUARK_CENSUS_EVERY", env, sizeof(env)) && sscanf(env, "%u", &a) == 1 && a)
+        census.every = a;
+    if (vkd3d_get_env_var("VKD3D_SQUARK_CENSUS_WINDOW", env, sizeof(env)) && sscanf(env, "%u-%u", &a, &b) == 2 && b > a)
+    {
+        census.window_start = a;
+        census.window_end = b;
+    }
+    INFO("VKD3D_SQUARK_CENSUS: counting D3D12 calls into %s (window %u-%u, snapshot every %u presents).\n",
+            census.path, census.window_start, census.window_end, census.every);
+    vkd3d_atomic_uint32_store_explicit(&vkd3d_squark_census_on, 1, vkd3d_memory_order_release);
+}
+
+void vkd3d_squark_census_count(enum squark_census_counter id, uint64_t n)
+{
+    __atomic_fetch_add(&census.total[id], n, __ATOMIC_RELAXED);
+    if (__atomic_load_n(&census.window_active, __ATOMIC_RELAXED))
+        __atomic_fetch_add(&census.window[id], n, __ATOMIC_RELAXED);
+}
+
+void vkd3d_squark_census_format(enum squark_census_fmt_kind kind, DXGI_FORMAT format)
+{
+    __atomic_fetch_add(&census.formats[kind][(unsigned int)format < SQC_FORMATS ? format : 0], 1, __ATOMIC_RELAXED);
+}
+
+static void squark_census_bump(uint64_t *array, unsigned int size, unsigned int index)
+{
+    __atomic_fetch_add(&array[index < size ? index : size - 1], 1, __ATOMIC_RELAXED);
+}
+
+void vkd3d_squark_census_view_dimension(enum squark_census_fmt_kind kind, unsigned int dimension)
+{
+    switch (kind)
+    {
+        case SQC_FMT_VIEW_SRV: squark_census_bump(census.srv_dims, ARRAY_SIZE(census.srv_dims), dimension); break;
+        case SQC_FMT_VIEW_UAV: squark_census_bump(census.uav_dims, ARRAY_SIZE(census.uav_dims), dimension); break;
+        case SQC_FMT_VIEW_RTV: squark_census_bump(census.rtv_dims, ARRAY_SIZE(census.rtv_dims), dimension); break;
+        case SQC_FMT_VIEW_DSV: squark_census_bump(census.dsv_dims, ARRAY_SIZE(census.dsv_dims), dimension); break;
+        default: break;
+    }
+}
+
+void vkd3d_squark_census_resource(const D3D12_RESOURCE_DESC1 *desc, const D3D12_HEAP_PROPERTIES *heap_properties)
+{
+    squark_census_bump(census.resource_dims, ARRAY_SIZE(census.resource_dims), desc->Dimension);
+    if (heap_properties)
+        squark_census_bump(census.heap_types, ARRAY_SIZE(census.heap_types), heap_properties->Type);
+    if (desc->Dimension == D3D12_RESOURCE_DIMENSION_BUFFER)
+        return;
+    vkd3d_squark_census_format(SQC_FMT_RES_TEXTURE, desc->Format);
+    if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET)
+        vkd3d_squark_census_format(SQC_FMT_RES_RENDER_TARGET, desc->Format);
+    if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
+        vkd3d_squark_census_format(SQC_FMT_RES_DEPTH_STENCIL, desc->Format);
+    if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)
+        vkd3d_squark_census_format(SQC_FMT_RES_UAV_TEXTURE, desc->Format);
+    if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS)
+        vkd3d_squark_census_format(SQC_FMT_RES_SIMULTANEOUS, desc->Format);
+}
+
+void vkd3d_squark_census_end_query(unsigned int type)
+{
+    squark_census_bump(census.end_query_types, ARRAY_SIZE(census.end_query_types), type);
+}
+
+void vkd3d_squark_census_feature(unsigned int feature)
+{
+    squark_census_bump(census.features, ARRAY_SIZE(census.features), feature);
+}
+
+void vkd3d_squark_census_record(enum squark_census_rec_kind kind, uint32_t a, uint32_t b, uint32_t c, uint32_t d,
+        uint32_t e, uint32_t f, uint32_t g, uint32_t h)
+{
+    uint32_t i = __atomic_fetch_add(&census.record_count[kind], 1, __ATOMIC_RELAXED);
+    struct squark_census_record *r;
+
+    if (i >= SQC_RECORDS)
+        return;
+    r = &census.records[kind][i];
+    r->a = a; r->b = b; r->c = c; r->d = d; r->e = e; r->f = f; r->g = g; r->h = h;
+}
+
+static void squark_census_write_counters(FILE *f, const char *title, const uint64_t *counters, uint64_t frames)
+{
+    unsigned int i;
+
+    fprintf(f, "[%s]\n", title);
+    for (i = 0; i < SQC_COUNT; i++)
+    {
+        uint64_t v = __atomic_load_n(&counters[i], __ATOMIC_RELAXED);
+        if (!v)
+            continue;
+        if (frames)
+            fprintf(f, "%-32s %12"PRIu64"  per_frame %.2f\n", squark_census_names[i], v, (double)v / frames);
+        else
+            fprintf(f, "%-32s %12"PRIu64"\n", squark_census_names[i], v);
+    }
+}
+
+static void squark_census_write_array(FILE *f, const char *title, const uint64_t *array, unsigned int size)
+{
+    unsigned int i;
+
+    fprintf(f, "[%s]\n", title);
+    for (i = 0; i < size; i++)
+    {
+        uint64_t v = __atomic_load_n(&array[i], __ATOMIC_RELAXED);
+        if (v)
+            fprintf(f, "%u %"PRIu64"\n", i, v);
+    }
+}
+
+static void squark_census_write_to(const char *path, const char *reason)
+{
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    unsigned int k, i, n;
+    FILE *f;
+
+    pthread_mutex_lock(&mutex);
+    if (!(f = fopen(path, "w")))
+    {
+        ERR("VKD3D_SQUARK_CENSUS: cannot write %s.\n", path);
+        pthread_mutex_unlock(&mutex);
+        return;
+    }
+    fprintf(f, "# vkd3d-proton squark census, written %s, presents %"PRIu64", window %u-%u\n",
+            reason, __atomic_load_n(&census.presents, __ATOMIC_RELAXED), census.window_start, census.window_end);
+    fprintf(f, "# formats are DXGI_FORMAT numbers; dimensions are the D3D12 enum values\n");
+    squark_census_write_counters(f, "total", census.total, 0);
+    if (census.window_end)
+        squark_census_write_counters(f, "window", census.window, census.window_end - census.window_start);
+    for (k = 0; k < SQC_FMT_KIND_COUNT; k++)
+    {
+        char title[64];
+        snprintf(title, sizeof(title), "formats %s", squark_census_fmt_kinds[k]);
+        squark_census_write_array(f, title, census.formats[k], SQC_FORMATS);
+    }
+    squark_census_write_array(f, "dimension srv", census.srv_dims, ARRAY_SIZE(census.srv_dims));
+    squark_census_write_array(f, "dimension uav", census.uav_dims, ARRAY_SIZE(census.uav_dims));
+    squark_census_write_array(f, "dimension rtv", census.rtv_dims, ARRAY_SIZE(census.rtv_dims));
+    squark_census_write_array(f, "dimension dsv", census.dsv_dims, ARRAY_SIZE(census.dsv_dims));
+    squark_census_write_array(f, "dimension resource", census.resource_dims, ARRAY_SIZE(census.resource_dims));
+    squark_census_write_array(f, "heap type of committed resources and heaps", census.heap_types, ARRAY_SIZE(census.heap_types));
+    squark_census_write_array(f, "end_query type", census.end_query_types, ARRAY_SIZE(census.end_query_types));
+    squark_census_write_array(f, "present sync_interval", census.sync_intervals, ARRAY_SIZE(census.sync_intervals));
+    squark_census_write_array(f, "check_feature_support feature", census.features, ARRAY_SIZE(census.features));
+    for (k = 0; k < SQC_REC_KIND_COUNT; k++)
+    {
+        n = __atomic_load_n(&census.record_count[k], __ATOMIC_RELAXED);
+        fprintf(f, "[records %s] %u\n", squark_census_rec_kinds[k], n);
+        for (i = 0; i < n && i < SQC_RECORDS; i++)
+        {
+            const struct squark_census_record *r = &census.records[k][i];
+            fprintf(f, "%u %u %u %u %u %u %u %u\n", r->a, r->b, r->c, r->d, r->e, r->f, r->g, r->h);
+        }
+    }
+    fclose(f);
+    pthread_mutex_unlock(&mutex);
+}
+
+static void squark_census_write(const char *reason)
+{
+    squark_census_write_to(census.path, reason);
+}
+
+void vkd3d_squark_census_present(unsigned int sync_interval)
+{
+    uint64_t n = __atomic_add_fetch(&census.presents, 1, __ATOMIC_RELAXED);
+
+    vkd3d_squark_census_count(SQC_PRESENT, 1);
+    squark_census_bump(census.sync_intervals, ARRAY_SIZE(census.sync_intervals), sync_interval);
+    if (census.window_end)
+    {
+        if (n == census.window_start)
+            __atomic_store_n(&census.window_active, 1, __ATOMIC_RELAXED);
+        if (n == census.window_end)
+        {
+            __atomic_store_n(&census.window_active, 0, __ATOMIC_RELAXED);
+            squark_census_write("at the end of the window");
+            return;
+        }
+    }
+    if (n % census.every == 0)
+    {
+        char path[540];
+        snprintf(path, sizeof(path), "%s.%"PRIu64, census.path, n);
+        squark_census_write_to(path, "as a periodic snapshot");
+    }
+}
+
+void vkd3d_squark_census_device_destroyed(void)
+{
+    squark_census_write("when the device was destroyed");
+}
+
+/* Applications seldom destroy the device before exiting; the DLL's destructors still run at a normal exit. */
+static void __attribute__((destructor)) squark_census_at_exit(void)
+{
+    if (vkd3d_squark_census_on)
+        squark_census_write("at process exit");
+}
